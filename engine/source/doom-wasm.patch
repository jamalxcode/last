diff --git a/src/doomtype.h b/src/doomtype.h
index 9947a07..36429a5 100644
--- a/src/doomtype.h
+++ b/src/doomtype.h
@@ -100,7 +100,20 @@
 
 #include <inttypes.h>
 
-#if defined(__cplusplus) || defined(__bool_true_false_are_defined)
+#if defined(__EMSCRIPTEN__) && !defined(__cplusplus)
+
+// Some Emscripten headers pull in <stdbool.h>, so whether `boolean` became a
+// 1-byte bool or a 4-byte enum depended on include order, and globals like
+// `netgame` ended up with different sizes in different files. Use an int
+// everywhere instead; the engine also relies on storing -1 in a boolean.
+
+typedef int boolean;
+
+#ifndef __bool_true_false_are_defined
+enum { false, true };
+#endif
+
+#elif defined(__cplusplus) || defined(__bool_true_false_are_defined)
 
 // Use builtin bool type with C++.
 
