diff --git a/opl/opl.c b/opl/opl.c
index a1aa1d9..718630c 100644
--- a/opl/opl.c
+++ b/opl/opl.c
@@ -23,6 +23,10 @@
 
 #include "SDL.h"
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
 #include "opl.h"
 #include "opl_internal.h"
 
@@ -285,6 +289,12 @@ opl_init_result_t OPL_Detect(void)
     int result1, result2;
     int i;
 
+#ifdef __EMSCRIPTEN__
+    // The browser build always uses the software OPL3 emulator, and the
+    // timer-based probe below would block forever on a single thread.
+    return OPL_INIT_OPL3;
+#endif
+
     // Reset both timers:
     OPL_WriteRegister(OPL_REG_TIMER_CTRL, 0x60);
 
@@ -491,6 +501,13 @@ void OPL_Delay(uint64_t us)
 
     // Wait until the callback is invoked.
 
+#ifdef __EMSCRIPTEN__
+    // No threads: yield to the browser so the audio callback can run.
+    while (!delay_data.finished)
+    {
+        emscripten_sleep(1);
+    }
+#else
     SDL_LockMutex(delay_data.mutex);
 
     while (!delay_data.finished)
@@ -499,6 +516,7 @@ void OPL_Delay(uint64_t us)
     }
 
     SDL_UnlockMutex(delay_data.mutex);
+#endif
 
     // Clean up.
 
